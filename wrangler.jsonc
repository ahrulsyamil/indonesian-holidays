{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "indonesian-holidays",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    // Your deployed Worker URL or custom domain.
    // Used as the OpenAPI servers.url value.
    "API_BASE_URL": "https://indonesian-holidays.ahrulsyamil.com"
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "indonesian-holidays.ahrulsyamil.com",
      "zone_name": "ahrulsyamil.com",
      "custom_domain": true
    }
  ],
  // D1 database binding.
  // database_id is NOT a secret — it cannot be used without your Cloudflare API token.
  // Contributors: run `bun x wrangler d1 create indonesian_holidays` and replace
  // the database_id below with your own.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "indonesian_holidays",
      "database_id": "5befbeba-3613-4cb5-99d8-4092e41b717f",
      "migrations_dir": "drizzle"
    }
  ]
}
