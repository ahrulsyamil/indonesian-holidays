{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "indonesian-holidays",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    // Your deployed Worker URL or custom domain.
    // Used as the OpenAPI servers.url value.
    "API_BASE_URL": "https://indonesian-holidays.ahrulsyamil.com"
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "indonesian-holidays.ahrulsyamil.com",
      "zone_name": "ahrulsyamil.com",
      "custom_domain": true
    }
  ],
  // D1 database binding.
  // database_id is NOT a secret — it cannot be used without your Cloudflare API token.
  // Contributors: run `bun x wrangler d1 create indonesian_holidays` and replace
  // the database_id below with your own.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "indonesian_holidays",
      "database_id": "5befbeba-3613-4cb5-99d8-4092e41b717f",
      "migrations_dir": "drizzle"
    }
  ],
  // Rate limiting bindings (Cloudflare Workers only — not available in local dev).
  // namespace_id is an arbitrary unique integer per binding.
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMIT_BURST",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 30, "period": 10 }
      },
      {
        "name": "RATE_LIMIT_SUSTAINED",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 600, "period": 60 }
      }
    ]
  }
}
