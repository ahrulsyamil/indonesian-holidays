{
  "name": "indonesian-holidays",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply indonesian_holidays --local",
    "db:migrate:prod": "wrangler d1 migrations apply indonesian_holidays --remote",
    "db:seed:local": "bun run scripts/seed.ts --local",
    "db:seed:local:fresh": "bun run scripts/seed.ts --local --fresh",
    "db:seed:prod": "bun run scripts/seed.ts --remote",
    "db:seed:prod:fresh": "bun run scripts/seed.ts --remote --fresh",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.3.0",
    "@scalar/hono-api-reference": "0.10.13",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cloudflare/vitest-pool-workers": "0.8.71",
    "@cloudflare/workers-types": "4.20260504.1",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "drizzle-kit": "0.31.10",
    "typescript": "^5.8.3",
    "vitest": "3.2.4",
    "wrangler": "4.87.0"
  }
}
